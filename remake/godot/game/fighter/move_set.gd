class_name MoveSet
extends Resource
## A fighting style: its command list, like the game's (`g_StyleCommands`, docs/ANIMATION.md).
##
## A command is a whole input sequence and the move it starts: ["P"] Blade Cut, ["P", "P"] Blade Hook,
## ["P", "P", "↓P"] Comet Blow. Inputs are codes: an optional direction relative to the opponent
## (→ toward, ← away, ↑ / ↓ sideways; motions like →→, ↓→, →↓→) plus P, K or G. From neutral only
## one-input commands match (Cmd_MatchSingle), trying `fallback` when nothing does (→→P, then →P,
## then P); at a move's cancel point the history plus the new input must match a whole command
## (Cmd_MatchSequence). Real styles are generated by remake/tools/conv_moves.py; the placeholder
## style still uses `root` + each move's `next`, turned into commands here.

@export var style_name := "Style"
@export var style_id := 0
@export var commands: Array = []        ## {"seq": PackedStringArray, "move": MoveData, "condition": bool}
@export var fallback: Dictionary = {}   ## input code -> the code to try next from neutral
@export var root: Dictionary = {}       ## placeholder styles: button ("P", "K") -> MoveData

var _built: Array = []


func get_commands() -> Array:
	if commands.size() > 0:
		return commands
	if _built.is_empty():
		for b in root:
			_walk(PackedStringArray([b]), root[b], 0)
	return _built


func _walk(seq: PackedStringArray, m: MoveData, depth: int) -> void:
	_built.append({"seq": seq, "move": m, "condition": false})
	if depth >= 6:
		return
	for b in m.next:
		var s := seq.duplicate()
		s.append(b)
		_walk(s, m.next[b], depth + 1)


## The move a whole input history starts, or null (Cmd_MatchSequence: same length, same codes).
func match_sequence(history: PackedStringArray) -> MoveData:
	for c in get_commands():
		if c["seq"] == history:
			return c["move"]
	return null


## From neutral: [move, code it matched] for one input, following the fallback chain; [] if none.
func match_single(code: String) -> Array:
	var tried := {}
	while code != "" and not tried.has(code):
		tried[code] = true
		var m := match_sequence(PackedStringArray([code]))
		if m:
			return [m, code]
		code = fallback.get(code, _default_fallback(code))
	return []


## Placeholder styles have no table: drop the direction (→P -> P).
func _default_fallback(code: String) -> String:
	if fallback.size() > 0:
		return ""
	for b in ["P", "K", "G"]:
		if code.ends_with(b) and code != b:
			return b
	return ""
